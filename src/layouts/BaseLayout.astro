---
import { ClientRouter } from "astro:transitions";
import "@fontsource/arimo/400.css";
import "@fontsource/arimo/500.css";
import "@fontsource/arimo/600.css";
import "@fontsource-variable/fraunces";
import "@fontsource/goudy-bookletter-1911/400.css";
import "../styles/global.css";
import { withBase } from "../lib/url";
import SectionNav from "../components/SectionNav.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Robotics engineer — projects in autonomous systems, computer vision, and mechanical design.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <SectionNav />
    <slot />
  </body>
</html>
