---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import { withBase } from "../lib/url";
import type { CollectionEntry } from "astro:content";
import type { PhotoExif } from "../lib/exif";

interface Props {
  photo: CollectionEntry<"photos">;
  exif: PhotoExif;
  slugs: string[];
  currentIndex: number;
}

const { photo, exif, slugs, currentIndex } = Astro.props;
const { title, image, alt, caption, location } = photo.data;
const isPortrait = image.height > image.width;
const metaParts = [exif.iso, exif.aperture, exif.shutterSpeed].filter(
  (v): v is string => Boolean(v)
);

const DOT_WINDOW = 3;
const nearStart = Math.max(0, currentIndex - DOT_WINDOW);
const nearEnd = Math.min(slugs.length - 1, currentIndex + DOT_WINDOW);
const farBefore = slugs.slice(0, nearStart);
const near = slugs.slice(nearStart, nearEnd + 1);
const farAfter = slugs.slice(nearEnd + 1);
---

<BaseLayout title={`${title} — Kevin Dong`} description={caption ?? alt} hideNav>
  <main class="photo-page">
    <div class="photo-stage">
      <a class="back-arrow" href={withBase("photography")} aria-label="Back to photography">
        ←
      </a>

      <figure class={`photo-frame ${isPortrait ? "portrait" : "landscape"}`}>
        <Image
          src={image}
          alt={alt}
          width={1200}
          widths={[480, 768, 1200]}
          sizes="(max-width: 900px) 100vw, 900px"
          quality={70}
          loading="eager"
          fetchpriority="high"
          transition:name={`photo-${photo.id}`}
        />
        <figcaption class="meta">
          <span class="meta-inner">
            <span class="meta-title">{title}</span>
            {location && <span class="meta-location">{location}</span>}
            {
              metaParts.length > 0 && (
                <span class="meta-exif">{metaParts.join(" · ")}</span>
              )
            }
          </span>
        </figcaption>
      </figure>
    </div>

    <div class="container photo-footer">
      {caption && <p class="caption-text">{caption}</p>}

      <nav class="photo-dots" aria-label="Other photos">
        {
          farBefore.length > 0 && (
            <div class="dots-far">
              {farBefore.map(() => (
                <span class="dot-far" aria-hidden="true" />
              ))}
            </div>
          )
        }
        <div class="dots-near">
          {
            near.map((slug, idx) => {
              const i = nearStart + idx;
              return (
                <a
                  href={withBase(`photography/${slug}`)}
                  class={`dot ${i === currentIndex ? "active" : ""}`}
                  aria-label={`Photo ${i + 1} of ${slugs.length}`}
                  aria-current={i === currentIndex ? "true" : undefined}
                >
                  <span class="dot-visual" />
                </a>
              );
            })
          }
        </div>
        {
          farAfter.length > 0 && (
            <div class="dots-far">
              {farAfter.map(() => (
                <span class="dot-far" aria-hidden="true" />
              ))}
            </div>
          )
        }
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .photo-page {
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .photo-stage {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1 1 0;
    min-height: 0;
    padding: var(--space-4) var(--space-6);
  }

  .back-arrow {
    flex: none;
    align-self: flex-start;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-text);
    padding: var(--space-2);
    margin-top: var(--space-4);
  }

  .back-arrow:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .photo-frame {
    margin: 0 auto;
    display: flex;
    width: fit-content;
    max-width: 100%;
    max-height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .photo-frame.landscape {
    flex-direction: column;
    align-items: center;
  }

  .photo-frame.portrait {
    flex-direction: row;
  }

  .photo-frame :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .photo-frame.landscape :global(img) {
    flex: 1 1 auto;
    min-height: 0;
    object-fit: contain;
  }

  .photo-frame.portrait :global(img) {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .meta {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .meta-inner {
    display: contents;
  }

  .meta-title {
    font-weight: 600;
    color: var(--color-text);
  }

  .meta-exif {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .photo-frame.portrait .meta {
    flex: none;
    width: 64px;
    align-items: center;
    justify-content: center;
    border-top: none;
    border-left: 1px solid var(--color-border);
    padding: var(--space-3);
    overflow: hidden;
  }

  .photo-frame.portrait .meta-inner {
    display: flex;
    flex-direction: row-reverse;
    align-items: baseline;
    gap: var(--space-4);
    white-space: nowrap;
    transform: rotate(-90deg);
  }

  .photo-frame.portrait .meta-exif {
    margin-left: 0;
  }

  .photo-footer {
    padding-bottom: var(--space-16);
  }

  .caption-text {
    margin-top: 0;
    margin-bottom: var(--space-4);
    max-width: 640px;
  }

  .photo-dots {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .dots-near {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .dots-far {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .dot-far {
    display: block;
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .dot {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
  }

  .dot-visual {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-border);
    transition: height var(--transition-fast), background-color var(--transition-fast);
  }

  .dot:hover .dot-visual {
    background: var(--color-text-muted);
  }

  .dot.active .dot-visual {
    height: 16px;
    background: var(--color-accent);
  }

  .dot.active:hover .dot-visual {
    background: var(--color-accent);
  }

  @media (max-width: 640px) {
    .photo-stage {
      align-items: flex-start;
      padding: var(--space-3) var(--space-4);
    }

    /* Not enough width for the side-by-side portrait strip - stack like landscape instead */
    .photo-frame.portrait {
      flex-direction: column;
    }

    .photo-frame.portrait :global(img) {
      flex: 1 1 auto;
      min-height: 0;
      min-width: 0;
      height: auto;
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    .photo-frame.portrait .meta {
      width: auto;
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      writing-mode: horizontal-tb;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding: var(--space-3) var(--space-4);
    }

    .photo-frame.portrait .meta-inner {
      display: contents;
    }

    .photo-frame.portrait .meta-exif {
      margin-left: auto;
    }
  }
</style>
