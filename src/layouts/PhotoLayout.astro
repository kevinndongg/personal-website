---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import { withBase } from "../lib/url";
import type { CollectionEntry } from "astro:content";
import type { PhotoExif } from "../lib/exif";

interface Props {
  photo: CollectionEntry<"photos">;
  exif: PhotoExif;
  prevSlug?: string;
  nextSlug?: string;
}

const { photo, exif, prevSlug, nextSlug } = Astro.props;
const { title, image, alt, caption, location } = photo.data;
const isPortrait = image.height > image.width;
const metaParts = [exif.iso, exif.aperture, exif.shutterSpeed].filter(
  (v): v is string => Boolean(v)
);
---

<BaseLayout title={`${title} — Kevin Dong`} description={caption ?? alt} hideNav>
  <main class="photo-page">
    <div class="photo-stage">
      <a class="back-arrow" href={withBase("photography")} aria-label="Back to photography">
        ←
      </a>

      <figure class={`photo-frame ${isPortrait ? "portrait" : "landscape"}`}>
        <Image
          src={image}
          alt={alt}
          width={1200}
          widths={[480, 768, 1200]}
          sizes="(max-width: 900px) 100vw, 900px"
          quality={70}
          loading="eager"
          fetchpriority="high"
          transition:name={`photo-${photo.id}`}
        />
        <figcaption class="meta">
          <span class="meta-inner">
            <span class="meta-title">{title}</span>
            {location && <span class="meta-location">{location}</span>}
            {
              metaParts.length > 0 && (
                <span class="meta-exif">{metaParts.join(" · ")}</span>
              )
            }
          </span>
        </figcaption>
      </figure>
    </div>

    <div class="container photo-footer">
      {caption && <p class="caption-text">{caption}</p>}

      <nav class="photo-nav">
        {
          prevSlug ? (
            <a href={withBase(`photography/${prevSlug}`)}>← Previous</a>
          ) : (
            <span />
          )
        }
        {
          nextSlug ? (
            <a href={withBase(`photography/${nextSlug}`)}>Next →</a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .photo-page {
    display: flex;
    flex-direction: column;
  }

  .photo-stage {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 100svh;
    padding: var(--space-4) var(--space-6);
  }

  .back-arrow {
    flex: none;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text);
    padding: var(--space-2);
  }

  .back-arrow:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .photo-frame {
    margin: 0 auto;
    display: flex;
    width: fit-content;
    max-width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .photo-frame.landscape {
    flex-direction: column;
  }

  .photo-frame.portrait {
    flex-direction: row;
    max-height: 92vh;
  }

  .photo-frame :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .photo-frame.landscape :global(img) {
    max-height: 88vh;
  }

  .photo-frame.portrait :global(img) {
    height: 100%;
    max-height: 92vh;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .meta {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .meta-inner {
    display: contents;
  }

  .meta-title {
    font-weight: 600;
    color: var(--color-text);
  }

  .meta-exif {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .photo-frame.portrait .meta {
    flex: none;
    width: 64px;
    align-items: center;
    justify-content: center;
    border-top: none;
    border-left: 1px solid var(--color-border);
    padding: var(--space-3);
    overflow: hidden;
  }

  .photo-frame.portrait .meta-inner {
    display: flex;
    flex-direction: row-reverse;
    align-items: baseline;
    gap: var(--space-4);
    white-space: nowrap;
    transform: rotate(-90deg);
  }

  .photo-frame.portrait .meta-exif {
    margin-left: 0;
  }

  .photo-footer {
    padding-bottom: var(--space-16);
  }

  .caption-text {
    margin-top: 0;
    margin-bottom: var(--space-4);
    max-width: 640px;
  }

  .photo-nav {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .photo-stage {
      align-items: flex-start;
      padding: var(--space-3) var(--space-4);
    }

    .photo-frame.landscape :global(img) {
      max-height: 70vh;
    }

    /* Not enough width for the side-by-side portrait strip - stack like landscape instead */
    .photo-frame.portrait {
      flex-direction: column;
      max-height: none;
    }

    .photo-frame.portrait :global(img) {
      height: auto;
      max-height: 70vh;
      width: 100%;
      object-fit: initial;
    }

    .photo-frame.portrait .meta {
      width: auto;
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      writing-mode: horizontal-tb;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding: var(--space-3) var(--space-4);
    }

    .photo-frame.portrait .meta-inner {
      display: contents;
    }

    .photo-frame.portrait .meta-exif {
      margin-left: auto;
    }
  }
</style>
