---
import { withBase } from "../lib/url";

interface Props {
  slug: string;
  title: string;
  summary: string;
  animation: string;
  role?: string;
  organization?: string;
  location?: string;
  period?: string;
  techStack?: string[];
}

const { slug, title, summary, animation, role, organization, location, period, techStack } =
  Astro.props;

const metaParts = [role, organization, location, period].filter(
  (v): v is string => Boolean(v)
);
---

<header class="hero">
  <div class="hero-animation" data-animation={animation} aria-hidden="true">
    <slot name="animation" />
  </div>
  <div class="hero-text container">
    <a class="back" href={withBase("")}>← Back to all projects</a>
    <h1 transition:name={`project-title-${slug}`}>{title}</h1>
    <p>{summary}</p>
    {metaParts.length > 0 && <p class="meta">{metaParts.join(" · ")}</p>}
    {
      techStack && techStack.length > 0 && (
        <ul class="tech-stack">
          {techStack.map((tech) => (
            <li class="tag">{tech}</li>
          ))}
        </ul>
      )
    }
  </div>
</header>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-8);
  }

  .hero-animation {
    height: 240px;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-animation {
      animation: none;
    }
  }

  .hero-text {
    padding-top: var(--space-6);
    max-width: 720px;
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.85rem;
  }

  .meta {
    margin: var(--space-2) 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .tech-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
  }
</style>
