---
import { withBase } from "../lib/url";

const path = Astro.url.pathname;
const homeHref = withBase("");
const photographyHref = withBase("photography");
const isPhotography = path.startsWith(photographyHref);

const contactLinks = [
  { label: "Email", href: "mailto:kevin.dong.haonan@gmail.com" },
  { label: "LinkedIn", href: "https://linkedin.com/in/kevindong30" },
  { label: "GitHub", href: "https://github.com/kevinndongg" },
];
---

<nav class="section-nav" aria-label="Site navigation">
  <div class="container">
    <div class="toggle">
      <a class="toggle-option" href={homeHref} aria-current={isPhotography ? undefined : "page"}>
        Robotics
      </a>
      <a
        class="toggle-option"
        href={photographyHref}
        aria-current={isPhotography ? "page" : undefined}
      >
        Photography
      </a>
      <span class="toggle-highlight" aria-hidden="true"></span>
    </div>

    <a class="nav-name" data-nav-name href={homeHref} aria-label="Kevin Dong — home">
      Kevin Dong
    </a>

    <ul class="contacts">
      {
        contactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .section-nav {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .section-nav .container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: "toggle name contacts";
    align-items: center;
    gap: var(--space-4);
  }

  .section-nav a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .section-nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .toggle {
    grid-area: toggle;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-self: start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-1);
  }

  .toggle-highlight {
    position: absolute;
    top: var(--space-1);
    bottom: var(--space-1);
    left: var(--space-1);
    width: calc(50% - var(--space-1));
    background: var(--color-accent-dim);
    border-radius: 999px;
    transition: transform var(--transition-medium);
    z-index: 0;
  }

  .toggle-option:nth-child(2)[aria-current="page"] ~ .toggle-highlight {
    transform: translateX(100%);
  }

  .toggle-option {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-2) var(--space-4);
    white-space: nowrap;
    border-radius: 999px;
  }

  .toggle-option[aria-current="page"] {
    color: var(--color-accent);
  }

  .contacts {
    grid-area: contacts;
    justify-self: end;
    list-style: none;
    display: flex;
    align-items: center;
    margin: 0;
    gap: var(--space-2);
    background: var(--color-accent-dim);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: calc(var(--space-1) + var(--space-2)) var(--space-4);
  }

  .contacts li {
    display: flex;
    align-items: center;
  }

  .contacts li:not(:first-child)::before {
    content: "·";
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }

  .contacts a {
    color: var(--color-text);
  }

  .contacts a:hover {
    color: var(--color-accent);
  }

  .nav-name {
    grid-area: name;
    justify-self: center;
    font-family: var(--font-name);
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--color-text);
    padding: var(--space-3) 0;
    opacity: 1;
    transform: scale(1);
    white-space: nowrap;
  }

  .nav-name:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-name:focus-visible {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-name[data-nav-name-state="animated"] {
      opacity: var(--scroll-progress, 0);
      transform: scale(calc(0.85 + 0.15 * var(--scroll-progress, 0)));
    }
  }

  @media (max-width: 480px) {
    .section-nav .container {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "name name"
        "toggle contacts";
      row-gap: var(--space-2);
      gap: var(--space-2);
    }

    .nav-name {
      justify-self: center;
    }

    .toggle .toggle-option {
      padding: var(--space-1) var(--space-2);
      font-size: 0.8rem;
    }

    .contacts {
      padding: var(--space-1) var(--space-2);
      gap: var(--space-1);
    }

    .contacts a {
      font-size: 0.8rem;
    }

    .nav-name {
      font-size: 1rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:before-preparation", (event) => {
    const fromPhotography = event.from.pathname.includes("/photography");
    const toPhotography = event.to.pathname.includes("/photography");
    if (fromPhotography && !toPhotography) {
      event.direction = "back";
    }
  });

  let cleanup: (() => void) | null = null;

  function initHeaderMorph() {
    cleanup?.();
    cleanup = null;

    const navName = document.querySelector<HTMLElement>("[data-nav-name]");
    if (!navName) return;

    navName.addEventListener("click", onNavNameClick);

    const heroName = document.querySelector<HTMLElement>("[data-hero-name]");
    const navEl = document.querySelector<HTMLElement>(".section-nav");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    navName.removeAttribute("data-nav-name-state");
    document.documentElement.style.removeProperty("--scroll-progress");

    if (!heroName || !navEl || reduceMotion) {
      cleanup = () => navName.removeEventListener("click", onNavNameClick);
      return;
    }

    navName.setAttribute("data-nav-name-state", "animated");

    let ticking = false;

    function computeProgress(): number {
      const navHeight = navEl!.getBoundingClientRect().height;
      const rect = heroName!.getBoundingClientRect();
      const morphDistance = Math.max(rect.height, 1);
      const raw = (navHeight - rect.top) / morphDistance;
      return Math.min(Math.max(raw, 0), 1);
    }

    function applyProgress() {
      document.documentElement.style.setProperty(
        "--scroll-progress",
        String(computeProgress())
      );
      ticking = false;
    }

    function onScrollOrResize() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(applyProgress);
    }

    window.addEventListener("scroll", onScrollOrResize, { passive: true });
    window.addEventListener("resize", onScrollOrResize, { passive: true });
    applyProgress();

    cleanup = () => {
      navName.removeEventListener("click", onNavNameClick);
      window.removeEventListener("scroll", onScrollOrResize);
      window.removeEventListener("resize", onScrollOrResize);
    };
  }

  function onNavNameClick(e: MouseEvent) {
    const heroName = document.querySelector("[data-hero-name]");
    if (!heroName) return;
    e.preventDefault();
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
  }

  initHeaderMorph();
  document.addEventListener("astro:page-load", initHeaderMorph);
</script>
