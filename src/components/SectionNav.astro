---
import { withBase } from "../lib/url";

const path = Astro.url.pathname;
const homeHref = withBase("");
const photographyHref = withBase("photography");
const isPhotography = path.startsWith(photographyHref);

const contactLinks = [
  { label: "Email", href: "mailto:kevin.dong.haonan@gmail.com" },
  { label: "LinkedIn", href: "https://linkedin.com/in/kevindong30" },
  { label: "GitHub", href: "https://github.com/kevinndongg" },
];
---

<nav class="section-nav" aria-label="Site navigation">
  <div class="container">
    <ul class="sections">
      <li>
        <a href={homeHref} aria-current={isPhotography ? undefined : "page"}>
          Robotics
        </a>
      </li>
      <li>
        <a href={photographyHref} aria-current={isPhotography ? "page" : undefined}>
          Photography
        </a>
      </li>
    </ul>

    <ul class="contacts">
      {
        contactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .section-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .section-nav .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .section-nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: var(--space-3) 0;
  }

  .section-nav a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .section-nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .sections a[aria-current="page"] {
    color: var(--color-accent);
  }

  .contacts a {
    color: var(--color-text);
  }

  .contacts a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .section-nav ul {
      gap: var(--space-4);
    }
  }
</style>
