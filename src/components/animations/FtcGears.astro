---
function teeth(count: number, cx: number, cy: number, radius: number, width: number, height: number) {
  return Array.from({ length: count }, (_, i) => ({
    angle: (360 / count) * i,
    x: cx - width / 2,
    y: cy - radius - height,
    width,
    height,
  }));
}

const gears = [
  { cx: 120, cy: 120, r: 46, hole: 10, teeth: teeth(12, 120, 120, 46, 7, 11), size: "big", spin: "spin-cw", duration: "8s" },
  { cx: 216, cy: 84, r: 30, hole: 7, teeth: teeth(8, 216, 84, 30, 6, 9), size: "small", spin: "spin-ccw", duration: "5.5s" },
  { cx: 268, cy: 156, r: 20, hole: 5, teeth: teeth(6, 268, 156, 20, 5, 7), size: "tiny", spin: "spin-cw", duration: "4s" },
];
---

<svg viewBox="0 0 320 220" role="img" aria-label="Interlocking gears assembling" class="gears">
  {
    gears.map((gear) => (
      <g
        class="entrance"
        data-size={gear.size}
        style={`transform-origin: ${gear.cx}px ${gear.cy}px;`}
      >
        <g
          class={`spin ${gear.spin}`}
          style={`transform-origin: ${gear.cx}px ${gear.cy}px; animation-duration: ${gear.duration};`}
        >
          <circle cx={gear.cx} cy={gear.cy} r={gear.r} class="gear-body" />
          {gear.teeth.map((t) => (
            <rect
              x={t.x}
              y={t.y}
              width={t.width}
              height={t.height}
              class="gear-tooth"
              transform={`rotate(${t.angle} ${gear.cx} ${gear.cy})`}
            />
          ))}
          <circle cx={gear.cx} cy={gear.cy} r={gear.hole} class="gear-hole" />
        </g>
      </g>
    ))
  }
</svg>

<style>
  .gears {
    width: 100%;
    height: 100%;
    max-width: 340px;
    padding: var(--space-4);
  }

  .gear-body {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .gear-tooth {
    fill: var(--color-accent);
  }

  .gear-hole {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .entrance {
    opacity: 0;
    transform: scale(0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .entrance[data-size="big"] {
      animation: assemble 0.5s ease-out 0.1s forwards;
    }
    .entrance[data-size="small"] {
      animation: assemble 0.5s ease-out 0.3s forwards;
    }
    .entrance[data-size="tiny"] {
      animation: assemble 0.5s ease-out 0.5s forwards;
    }

    .spin {
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-delay: 0.6s;
    }
    .spin-cw {
      animation-name: spin-cw;
    }
    .spin-ccw {
      animation-name: spin-ccw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entrance {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes assemble {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes spin-cw {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes spin-ccw {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }
</style>
