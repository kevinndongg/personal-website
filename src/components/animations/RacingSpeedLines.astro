---
const lines = [
  { y: 60, length: 90, delay: 0 },
  { y: 82, length: 130, delay: 0.06 },
  { y: 104, length: 70, delay: 0.12 },
  { y: 150, length: 110, delay: 0.18 },
  { y: 172, length: 60, delay: 0.24 },
  { y: 194, length: 100, delay: 0.3 },
];
---

<div class="racing" data-speed-scene>
  <svg viewBox="0 0 340 220" role="img" aria-label="Race car with motion streaks" class="racing-svg">
    <g class="streaks">
      {
        lines.map((line) => (
          <line
            x1={330}
            x2={330 - line.length}
            y1={line.y}
            y2={line.y}
            class="streak"
            style={`animation-delay: ${line.delay}s;`}
          />
        ))
      }
    </g>

    <g class="car">
      <rect x="50" y="120" width="200" height="38" rx="10" class="car-body" />
      <path d="M95,120 L112,82 L188,82 L205,120 Z" class="car-body" />
      <rect x="118" y="90" width="60" height="26" rx="4" class="car-glass" />
      <circle cx="95" cy="160" r="17" class="wheel" />
      <circle cx="95" cy="160" r="6" class="wheel-hub" />
      <circle cx="205" cy="160" r="17" class="wheel" />
      <circle cx="205" cy="160" r="6" class="wheel-hub" />
    </g>
  </svg>

  <div class="speedometer">
    <span data-speed-counter>0</span><span class="unit">mph</span>
  </div>
</div>

<script>
  function animateSpeedCounters() {
    document
      .querySelectorAll<HTMLElement>("[data-speed-counter]")
      .forEach((el) => {
        const target = 60;
        const duration = 900;
        const start = performance.now();

        function tick(now: number) {
          const progress = Math.min((now - start) / duration, 1);
          el.textContent = String(Math.round(progress * target));
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      });
  }

  animateSpeedCounters();
  document.addEventListener("astro:page-load", animateSpeedCounters);
</script>

<style>
  .racing {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .racing-svg {
    width: 100%;
    height: 100%;
  }

  .car-body {
    fill: var(--color-text);
  }

  .car-glass {
    fill: var(--color-bg);
  }

  .wheel {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 3;
  }

  .wheel-hub {
    fill: var(--color-accent);
  }

  .streak {
    stroke: var(--color-accent);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0;
  }

  .speedometer {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-4);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .speedometer .unit {
    margin-left: var(--space-1);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .car {
      animation: idle-pulse 3s ease-in-out infinite;
      transform-origin: 150px 150px;
    }

    .streak {
      animation: sweep-in 0.5s ease-out forwards, idle-flicker 2.4s ease-in-out 0.6s infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .streak {
      opacity: 0.6;
    }
  }

  @keyframes sweep-in {
    from {
      opacity: 0;
      transform: translateX(60px);
    }
    to {
      opacity: 0.8;
      transform: translateX(0);
    }
  }

  @keyframes idle-flicker {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes idle-pulse {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(-4px);
    }
  }
</style>
