---
import { getCollection } from "astro:content";
import { slide } from "astro:transitions";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import { sortPhotos } from "../../lib/photos";

const photos = sortPhotos(await getCollection("photos"));
---

<BaseLayout
  title="Photography — Kevin Dong"
  description="A collection of personal photography."
>
  <main class="container" transition:name="page" transition:animate={slide({ duration: "400ms" })}>
    <header class="hero">
      <h1>Photography</h1>
      <p>Photos I've taken, just for fun.</p>
    </header>

    <section class="masonry" aria-label="Photos">
      {
        photos.map((photo) => (
          <PhotoCard
            slug={photo.id}
            title={photo.data.title}
            image={photo.data.image}
            alt={photo.data.alt}
          />
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-8);
    max-width: 640px;
  }

  .masonry {
    columns: 280px 3;
    column-gap: var(--space-6);
    padding-bottom: var(--space-16);
  }

  @media (max-width: 640px) {
    .masonry {
      columns: 1;
    }
  }
</style>
