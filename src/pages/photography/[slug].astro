---
import { getCollection } from "astro:content";
import PhotoLayout from "../../layouts/PhotoLayout.astro";
import { getPhotoExif } from "../../lib/exif";
import { sortPhotos } from "../../lib/photos";

export async function getStaticPaths() {
  const photos = sortPhotos(await getCollection("photos"));

  const slugs = photos.map((photo) => photo.id);

  return photos.map((photo, index) => ({
    params: { slug: photo.id },
    props: {
      photo,
      slugs,
      currentIndex: index,
    },
  }));
}

const { photo, slugs, currentIndex } = Astro.props;
const exif = await getPhotoExif(photo.id);
---

<PhotoLayout photo={photo} exif={exif} slugs={slugs} currentIndex={currentIndex} />
