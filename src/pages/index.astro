---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import sharp from "sharp";
import { statSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import FilmCanister from "../components/FilmCanister.astro";
import { withBase } from "../lib/url";
import type { ZoneMedia } from "../game/world";
import { contactLinks } from "../lib/contact";
import { lightTableOrder, sortPhotos } from "../lib/photos";
import "../styles/game.css";
import "../styles/intro.css";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const photos = await getCollection("photos");

// Every photo, in the order the light table reads them (see `lightTableOrder`: a page is read across, two landscape photos
// and a portrait one a row). The light table lays them out a page at a time and the camera zooms
// into one, and it has to work for any number of photos, so each one goes in as plain data: an image big enough to fill
// the screen when zoomed into, and its aspect so that the layout is known before any image has loaded. The game loads
// the images only for the page that is showing (and the next), so adding photos only adds a file under
// src/content/photos.
const fileOf = new Map<string, string>(); // a photo's url (below) -> the file it came from
const reel = lightTableOrder(
  await Promise.all(
    sortPhotos(photos).map(async (p) => {
      const { width, height } = p.data.image;
      const src = (await getImage({ src: p.data.image, width: 1400 })).src;
      fileOf.set(src, (p.data.image as { fsPath?: string }).fsPath ?? "");
      return {
        src,
        aspect: width / height,
        title: p.data.title,
        location: p.data.location,
      };
    })
  )
);

// The loading screen's strip has a frame for each photo of the light table's first two pages (PAGE_SLOTS * 2 in
// src/game/scenery.ts): those are the photos the scene waits for before it is shown, however many the gallery grows to.
// Each frame carries small copies of its photo, in the page itself, so the film comes out of the canister with its photos
// on it from the first paint (the real photos are the slowest thing on the page: a loader cannot wait on what it is
// loading). Two copies: black and white, which is what the frame shows while loading, and colour, which fades in over
// it at the end. They are made here, so that the strip carries no CSS filter (each is an extra pass for the GPU every
// frame it moves). A few KB each; "inside" keeps the photo's own proportions, whichever way it is.
const INTRO_PHOTOS = 12;
const THUMB = 112;
interface Thumbs {
  colour: string;
  bw: string;
}
// kept between requests (the dev server renders this page each time it is loaded, and the sources are up to 15 MB each)
const thumbCache: Map<string, Thumbs> = ((globalThis as { __introThumbs?: Map<string, Thumbs> }).__introThumbs ??= new Map());
async function thumbnails(file: string | undefined): Promise<Thumbs | undefined> {
  if (!file) return undefined;
  try {
    const key = `${file}:${statSync(file).mtimeMs}`;
    const hit = thumbCache.get(key);
    if (hit) return hit;
    const base = sharp(file).rotate().resize({ width: THUMB, height: THUMB, fit: "inside" }); // (rotate: the photo's own orientation, as `getImage` does)
    const [colour, bw] = await Promise.all([
      base.clone().webp({ quality: 50 }).toBuffer(),
      base.clone().grayscale().webp({ quality: 45 }).toBuffer(),
    ]);
    const uri = (data: Buffer) => `data:image/webp;base64,${data.toString("base64")}`;
    const thumbs = { colour: uri(colour), bw: uri(bw) };
    thumbCache.set(key, thumbs);
    return thumbs;
  } catch (error) {
    console.warn(`loading screen: no thumbnail for ${file}`, error);
    return undefined; // the frame is left dark until the real photo arrives
  }
}
const introPhotos = await Promise.all(
  reel.slice(0, INTRO_PHOTOS).map(async (p) => ({ ...p, thumb: await thumbnails(fileOf.get(p.src)) }))
);

/** The project's markdown body: the lead sentence(s), and the bullet list that carries the results. */
function parseBody(body = "") {
  const lines = body
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter(Boolean);
  const isBullet = (l: string) => /^[-*]\s+/.test(l);
  return {
    lead: lines.filter((l) => !isBullet(l)).join(" "),
    bullets: lines.filter(isBullet).map((l) => l.replace(/^[-*]\s+/, "")),
  };
}

/** A project's `media` as the card shows it: images optimized (the card is up to about 1000px wide on a big screen, and 580px at its base size, so this is enough for sharp ones), paths made final. */
async function cardMedia(items: NonNullable<(typeof projects)[number]["data"]["media"]> = []): Promise<ZoneMedia[]> {
  return Promise.all(
    items.map(async (m): Promise<ZoneMedia> => {
      const { size, caption } = m;
      if (m.type === "image") {
        const { src, attributes } = await getImage({ src: m.src, width: 1200 });
        return { type: "image", src, width: Number(attributes.width), height: Number(attributes.height), alt: m.alt, size, caption };
      }
      if (m.type === "video") {
        const { width, height, alt } = m;
        return { type: "video", src: withBase(m.src), poster: withBase(m.poster), width, height, alt, size, caption };
      }
      const params = new URLSearchParams({ autoplay: "1", rel: "0" });
      if (m.start) params.set("start", String(m.start));
      const embed = `https://www.youtube-nocookie.com/embed/${m.id}?${params}`;
      return { type: "youtube", embed, poster: withBase(m.poster), title: m.title, size, caption };
    })
  );
}

const zones = [
  ...(await Promise.all(
    projects.map(async (p) => {
      const { lead, bullets } = parseBody(p.body);
      const links = p.data.links ?? {};
      return {
        id: p.id,
        kind: "project" as const,
        label: p.data.title,
        summary: lead || p.data.summary,
        bullets,
        variant: p.id === "cmu-racing" ? ("garage" as const) : p.id === "ftc" ? ("ftc" as const) : undefined,
        href: withBase(`projects/${p.id}`),
        accent: p.data.accentColor,
        role: p.data.role,
        period: p.data.period ?? p.data.dateRange,
        organization: p.data.organization,
        brand: p.data.cardBrand,
        brandNote: p.data.cardNote,
        subtitle: p.data.cardTitle,
        techStack: p.data.techStack,
        media: await cardMedia(p.data.media),
        // the logo, shown whole beside the title
        image: p.data.image && p.data.cardLogo !== false ? (await getImage({ src: p.data.image, width: 240 })).src : undefined,
        actions: [
          links.paper && { label: "Read the paper", href: links.paper, external: true },
          links.repo && { label: "Source code", href: links.repo, external: true },
          links.demo && { label: "Live demo", href: links.demo, external: true },
        ].filter(Boolean),
      };
    })
  )),
  {
    id: "gallery",
    kind: "gallery" as const,
    variant: "photodesk" as const,
    label: "Photo Gallery",
    summary: `${photos.length} photos I took just for fun — quiet streets, soft light, small moments.`,
    // only the no-JS fallback list links out: in the diorama the gallery is the scene itself
    href: withBase("photography"),
    accent: "#8a4fd0",
    photos: reel,
  },
  // the name: it opens a short card about you (draft copy: edit it here)
  {
    id: "hub",
    kind: "about" as const,
    label: "Kevin Dong",
    role: "Computer Science at CMU",
    summary: "Robotics engineer building mechanical systems, autonomous flight, and vision models.",
    actions: contactLinks.map((l) => ({ ...l, external: !l.href.startsWith("mailto:") })),
    accent: "#8a5a35",
  },
  // the contact links: a slab each, which opens its link when it is pressed (no card)
  ...contactLinks.map((l) => ({
    id: l.label.toLowerCase(),
    kind: "link" as const,
    label: l.label,
    summary: "",
    href: l.href,
    accent: "#2f74e0",
  })),
];
---

<BaseLayout title="Kevin Dong" description="A tiny diorama that doubles as my portfolio." hideNav>
  <div class="game" id="game" data-zones={JSON.stringify(zones)}>
    <!--
      The loading screen: a 35 mm film canister standing at the left of a bar, with its film pulled out to the right as
      the world loads. It is plain markup so that it is painted before any script has run (the scene blocks the page while it
      is built), and `src/game/intro.ts` moves it. Each frame holds one of the first photos, turned to fill the frame when
      it is a portrait one.
    -->
    <div
      class="intro"
      data-intro
      role="progressbar"
      aria-label="Loading the workshop"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="intro-reel" data-intro-reel style={`--n:${introPhotos.length}`}>
        <!-- everything inside is placed from the stage's bottom edge, where the canister stands -->
        <div class="intro-stage">
          <!-- the film's shadow: it comes out of the slit as the film does, and moves with it -->
          <div class="intro-shadow-gate" aria-hidden="true"><span class="intro-film-shadow" data-intro-shadow></span></div>
          <!-- the gate: the film comes from behind the canister's barrel, and is cut off where it is still behind it -->
          <div class="intro-gate">
            <!-- laid out as it comes out: the last frame next to the canister, frame 1 at the tongue, which leads -->
            <div class="intro-strip" data-intro-strip>
              {
                introPhotos
                  .map((p, i) => ({ p, i }))
                  .reverse()
                  .map(({ p, i }) => (
                    <figure class:list={["intro-frame", p.aspect < 1 && "portrait"]} data-intro-frame data-src={p.src}>
                      <span class="intro-window" data-intro-window>
                        {p.thumb && <img class="bw" src={p.thumb.bw} alt="" />}
                        {p.thumb && <img class="colour" src={p.thumb.colour} alt="" />}
                      </span>
                      <span class="intro-num" aria-hidden="true">{i + 1}</span>
                    </figure>
                  ))
              }
              <span class="intro-tongue" aria-hidden="true"></span>
              <!-- the tongue's end, cut at the corners: its own shape, transparent outside it (a clip-path would make the strip a mask) -->
              <span class="intro-tip" aria-hidden="true"></span>
            </div>
          </div>
          <div class="intro-bar" aria-hidden="true"><span class="intro-bar-fill" data-intro-fill></span></div>
          <!-- the canister: it does not move, the film does; only the spool's knob turns, as the film goes out -->
          <FilmCanister />
        </div>
      </div>
    </div>
    <!-- already played in this page (the visitor has moved about the site since: a reload or a new visit plays it again): gone
         before the first paint (`createIntro` does the same when the script runs) -->
    <script is:inline>
      if (window.__introPlayed) document.querySelector("[data-intro]").hidden = true;
    </script>
    <noscript><style>.intro { display: none; } .fallback { display: grid; }</style></noscript>
    <canvas data-canvas aria-label="A miniature diorama of my projects. Click a building to open its summary."></canvas>
    <div data-labels class="labels" aria-hidden="true"></div>

    <!-- a page torn from a notebook, with an arrow drawn toward the racing area (see `placeHint` in src/game/main.ts) -->
    <p class="hint" data-hint>
      <span class="hint-body">
        <span class="hint-shade"><span class="hint-paper" data-hint-paper>Pick an area to <span class="scribble">look inside</span></span></span>
        <svg class="hint-arrow side" viewBox="0 0 52 30" aria-hidden="true">
          <path pathLength="1" d="M3 17 C 14 10, 24 22, 36 14 S 44 15, 47 15"></path>
          <path pathLength="1" d="M39 7 C 43 10, 46 13, 48 15 C 45 18, 42 21, 38 24"></path>
        </svg>
        <svg class="hint-arrow down" viewBox="0 0 30 52" aria-hidden="true">
          <path pathLength="1" d="M17 3 C 10 14, 22 24, 14 36 S 15 44, 15 47"></path>
          <path pathLength="1" d="M7 39 C 10 43, 13 46, 15 48 C 18 45, 21 42, 24 38"></path>
        </svg>
      </span>
    </p>

    <!-- announces the photo on the table (the title and place are drawn on the film, which a screen reader cannot read) -->
    <p class="sr-only" data-live aria-live="polite"></p>

    <div class="backdrop" data-backdrop hidden></div>
    <aside class="panel" data-panel hidden role="dialog" aria-modal="true" aria-labelledby="panel-title">
      <button class="close" type="button" data-close aria-label="Close">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"></path></svg>
      </button>
      <div class="sheet" data-sheet>
      <button class="grip" type="button" data-grip aria-label="Show more or less" aria-expanded="false"><span></span></button>
      <div class="body">
        <header class="head">
          <div class="brand" data-brand hidden>
            <img class="logo" data-logo alt="" hidden />
            <p class="org" id="panel-brand" data-org hidden></p>
            <p class="note" data-note hidden></p>
          </div>
          <h2 id="panel-title" data-title></h2>
          <p class="role" data-role></p>
          <div class="when" data-when hidden>
            <p class="kicker" data-kicker></p>
            <span class="badge" data-badge hidden>Under construction</span>
          </div>
        </header>
        <p class="summary" data-summary></p>
        <ul class="bullets" data-bullets></ul>
        <ul class="tags" data-tags></ul>
        <div class="media" data-media hidden></div>
        <div class="actions" data-actions></div>
      </div>
      </div>
    </aside>

    <nav class="fallback" aria-label="Projects">
      <h1>Kevin Dong</h1>
      <ul>
        {zones.filter((z) => z.kind !== "link").map((z) => (z.href ? <li><a href={z.href}>{z.label}</a></li> : (z.actions ?? []).map((a) => <li><a href={a.href}>{z.label}: {a.label}</a></li>)))}
      </ul>
      <noscript><p>The interactive diorama needs JavaScript. These links go straight to each page.</p></noscript>
    </nav>
  </div>
</BaseLayout>

<script>
  import { createIntro } from "../game/intro";
  import type { Intro } from "../game/intro";

  let stop: (() => void) | undefined;
  let intro: Intro | null = null;
  let left = false; // the page was left while the scene's code was still arriving

  document.addEventListener("astro:page-load", async () => {
    const root = document.getElementById("game");
    if (!root) return;
    left = false;
    // starts the loader (and the photos and fonts it measures) before the scene's code, which is the big download
    intro = createIntro(root);
    // loaded with import() so that the loader can say when the code has arrived
    const { startGame } = await import("../game/main");
    if (left) return;
    intro?.stage("code", 1);
    // The scene is built in one go, which blocks the page for a while: let the film's move reach the compositor first (two
    // frames), so that it keeps going through the block.
    if (intro) await new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));
    if (left) return;
    try {
      stop = startGame(root, intro);
    } catch (error) {
      // no WebGL, say: the loader goes and the plain list of links takes its place
      console.error(error);
      root.classList.add("no-webgl");
      intro?.cancel();
    }
  });
  document.addEventListener("astro:before-swap", () => {
    left = true;
    stop?.();
    stop = undefined;
    intro?.cancel();
    intro = null;
  });
</script>
