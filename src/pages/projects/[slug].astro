---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import FtcGears from "../../components/animations/FtcGears.astro";
import RacingSpeedLines from "../../components/animations/RacingSpeedLines.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const animationComponents: Record<string, any> = {
  "ftc-gears": FtcGears,
  "racing-speed-lines": RacingSpeedLines,
};

const AnimationComponent = animationComponents[project.data.animation];
---

<ProjectLayout project={project}>
  <Fragment slot="animation">
    {AnimationComponent && <AnimationComponent />}
  </Fragment>
  <Content />
</ProjectLayout>
